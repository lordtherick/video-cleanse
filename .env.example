# ---- Required ------------------------------------------------------------
# Video file to review (inside VIDEO_DIR)
VIDEO_FILENAME=brae-animal-company.mp4

# Word to find and redact (case-insensitive; comma-separate for several, e.g. brae,braes)
TARGET_WORD=brae

# ---- Section of the video to review --------------------------------------
# Seconds into the video. END_SECONDS blank or 0 = review to the end.
# Frames outside this window are copied through unchanged.
START_SECONDS=0
END_SECONDS=

# ---- Redaction style -----------------------------------------------------
# blur  = Gaussian blur over the word
# block = solid box over the word (colour set by BLOCK_COLOUR)
REDACT_MODE=blur

# ---- Optional ------------------------------------------------------------
# Folder on your machine containing the video (mounted as /data)
VIDEO_DIR=.
# Output name; blank = <input>_redacted.mp4
OUTPUT_FILENAME=

# Tuning
# run OCR every N frames (1 = every frame, slowest/most thorough)
OCR_INTERVAL=5
# keep redaction on N frames after last detection (stops flicker)
HOLD_FRAMES=10
# extra pixels around the detected word
PADDING=10
# OCR confidence threshold (0-1)
MIN_CONFIDENCE=0.3
# blur kernel size, odd number; bigger = heavier blur
BLUR_STRENGTH=51
# R,G,B for block mode
BLOCK_COLOUR=0,0,0
# output quality (lower = better, larger file)
CRF=18
# x264 speed preset
PRESET=fast
# seconds between progress log lines
PROGRESS_SECONDS=10
USE_GPU=false
